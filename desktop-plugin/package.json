{
  "name": "dsh-desktop-bun",
  "version": "0.12.0",
  "description": "DSH 桌面壳的桌面半区插件：给 dsh 页面注入桌面 chrome（桌面设置面板/通知/下载/快捷键桥/控制台镜像），并注册「DSH 桌面壳」技能",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperion2144/dsh-desktop-bun.git"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/client.js",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "desktop",
    "tauri",
    "skill",
    "china-mirror",
    "windows"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test:client": "node scripts/test-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/react": "^18",
    "esbuild": "^0.24.0",
    "qrcode-generator": "^2.0.4",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
